# Softened version of cursor-trail-lightning (built into kitty).
# Shader defaults in parentheses.
startgroup
    animation_start cursor-trail-move
    animation_stop cursor-trail-stop
    # Shorter flash (0.14)
    var float DURATION = 0.1
    # Narrower glow (5.5)
    var float GLOW_WIDTH = 1.8
    # Thinner core stroke (1.15)
    var float CORE_WIDTH = 0.6
    # Less zigzag (0.085)
    var float JAGGEDNESS = 0.035
    shaders cursor-trail-lightning
endgroup
