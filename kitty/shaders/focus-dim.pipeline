# focus-highlight (built into kitty) without brightening the focused pane:
# only dims the rest on focus change. Defaults in parentheses.
startgroup
    # Pane/tab changes only. The built-in uses window-focus-in, which kitty
    # also fires when the macOS window regains focus (e.g. when saving in
    # nvim). A pane/tab change always comes with window-focus-out; macOS
    # focus returning does not.
    animation_start window-focus-out
    # os-window-focus-out as a stop prevents starting when kitty loses macOS
    # focus (a *-focus-out stop in the same tick cancels the start).
    # Duration in ms (750)
    animation_stop 400 | os-window-focus-out
    animation_curve ease-in
    animation_step 16
    # No extra brightness on the active pane (0.30)
    var float HIGHLIGHT_INTENSITY = 0
    # No glow on the active pane's border (0.04)
    var float BORDER_WIDTH = 0
    # Don't dim the active pane's padding (false). In versions after 0.49.1
    # it also covers its border (window_border_width):
    # kovidgoyal/kitty@8e80e96c64
    var bool INCLUDE_WINDOW_PADDING = true
    # Don't dim the tab bar, only the panes (false)
    var bool DIM_CENTRAL_AREA_ONLY = true
    # Fraction of color kept by unfocused panes; lower = darker (0.3)
    var float INACTIVE_DIM = 0.15
    shaders focus-highlight
endgroup
