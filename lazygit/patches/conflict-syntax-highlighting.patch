diff --git a/pkg/gui/mergeconflicts/highlight.go b/pkg/gui/mergeconflicts/highlight.go
new file mode 100644
index 0000000..8bdb8b3
--- /dev/null
+++ b/pkg/gui/mergeconflicts/highlight.go
@@ -0,0 +1,195 @@
+package mergeconflicts
+
+import (
+	"bytes"
+	"os"
+	"path/filepath"
+	"strings"
+	"sync"
+
+	"github.com/alecthomas/chroma/v2"
+	"github.com/alecthomas/chroma/v2/formatters"
+	"github.com/alecthomas/chroma/v2/lexers"
+	"github.com/alecthomas/chroma/v2/styles"
+	"github.com/jesseduffield/lazygit/pkg/utils"
+)
+
+// The merge conflicts view renders the raw file rather than a diff, so the
+// configured diff renderer (delta and friends) never sees it and every line
+// comes out in the default colour. We run the content through chroma here so
+// the view keeps the syntax colours of the file being merged.
+//
+// Set LAZYGIT_CONFLICT_SYNTAX_THEME to any chroma style name to change the
+// palette, or to "none" to turn the highlighting off.
+
+const defaultSyntaxTheme = "gruvbox"
+
+type highlightCacheEntry struct {
+	path    string
+	content string
+	lines   []string
+}
+
+var (
+	highlightCacheMutex sync.Mutex
+	highlightCache      highlightCacheEntry
+)
+
+// highlightedLines returns one syntax-highlighted string per line of content,
+// or nil when the file's language isn't recognised. Marker lines are blanked
+// out before lexing (they'd throw the lexer off) and are coloured by the
+// caller anyway.
+func highlightedLines(path string, content string, conflicts []*mergeConflict) []string {
+	if path == "" {
+		return nil
+	}
+
+	highlightCacheMutex.Lock()
+	defer highlightCacheMutex.Unlock()
+
+	if highlightCache.path == path && highlightCache.content == content {
+		return highlightCache.lines
+	}
+
+	lines := highlightContent(path, content, conflicts)
+	highlightCache = highlightCacheEntry{path: path, content: content, lines: lines}
+
+	return lines
+}
+
+func highlightContent(path string, content string, conflicts []*mergeConflict) []string {
+	themeName := os.Getenv("LAZYGIT_CONFLICT_SYNTAX_THEME")
+	if themeName == "none" {
+		return nil
+	}
+	if themeName == "" {
+		themeName = defaultSyntaxTheme
+	}
+
+	lexer := lexers.Match(filepath.Base(path))
+	if lexer == nil {
+		return nil
+	}
+	lexer = chroma.Coalesce(lexer)
+
+	style := withoutBackgrounds(styles.Get(themeName))
+	formatter := formatters.Get(terminalFormatterName())
+	if formatter == nil {
+		return nil
+	}
+
+	iterator, err := lexer.Tokenise(nil, blankOutMarkerLines(content, conflicts))
+	if err != nil {
+		return nil
+	}
+
+	var lines []string
+	for _, tokenLine := range chroma.SplitTokensIntoLines(iterator.Tokens()) {
+		line, err := formatLine(tokenLine, style, formatter)
+		if err != nil {
+			return nil
+		}
+		lines = append(lines, line)
+	}
+
+	return lines
+}
+
+// formatLine renders a line's tokens, leaving the ones that would come out in
+// the style's plain text colour untouched: emitting an escape sequence for
+// those would override the user's `defaultFgColor` and bloat every line.
+func formatLine(tokenLine []chroma.Token, style *chroma.Style, formatter chroma.Formatter) (string, error) {
+	plain := style.Get(chroma.Background)
+
+	var buf bytes.Buffer
+	pending := make([]chroma.Token, 0, len(tokenLine))
+
+	flush := func() error {
+		if len(pending) == 0 {
+			return nil
+		}
+		err := formatter.Format(&buf, style, chroma.Literator(pending...))
+		pending = pending[:0]
+		return err
+	}
+
+	for _, token := range tokenLine {
+		// the newline belongs to the line break, not to the token's colour
+		token.Value = strings.ReplaceAll(token.Value, "\n", "")
+		if token.Value == "" {
+			continue
+		}
+
+		if isPlain(style.Get(token.Type), plain) {
+			if err := flush(); err != nil {
+				return "", err
+			}
+			buf.WriteString(token.Value)
+			continue
+		}
+
+		pending = append(pending, token)
+	}
+
+	if err := flush(); err != nil {
+		return "", err
+	}
+
+	return buf.String(), nil
+}
+
+// isPlain reports whether an entry renders identically to the style's plain
+// text. NoInherit is normalised away: it's set on the Background entry only,
+// and says where the colour came from rather than how it looks.
+func isPlain(entry chroma.StyleEntry, plain chroma.StyleEntry) bool {
+	entry.NoInherit = plain.NoInherit
+	return entry == plain
+}
+
+// blankOutMarkerLines replaces the conflict markers with empty lines, keeping
+// the line count intact, so that `<<<<<<< HEAD` and friends don't derail the
+// lexer's state.
+func blankOutMarkerLines(content string, conflicts []*mergeConflict) string {
+	lines := utils.SplitLines(content)
+
+	for _, conflict := range conflicts {
+		for _, idx := range []int{conflict.start, conflict.ancestor, conflict.target, conflict.end} {
+			if idx >= 0 && idx < len(lines) {
+				lines[idx] = ""
+			}
+		}
+	}
+
+	return strings.Join(lines, "\n")
+}
+
+// withoutBackgrounds strips background colours from the style: lazygit paints
+// the selected hunk with its own background and chroma's would fight it.
+func withoutBackgrounds(style *chroma.Style) *chroma.Style {
+	if style == nil {
+		return styles.Fallback
+	}
+
+	builder := style.Builder()
+	for _, tokenType := range style.Types() {
+		entry := style.Get(tokenType)
+		entry.Background = 0
+		builder.AddEntry(tokenType, entry)
+	}
+
+	stripped, err := builder.Build()
+	if err != nil {
+		return style
+	}
+
+	return stripped
+}
+
+func terminalFormatterName() string {
+	switch os.Getenv("COLORTERM") {
+	case "truecolor", "24bit":
+		return "terminal16m"
+	default:
+		return "terminal256"
+	}
+}
